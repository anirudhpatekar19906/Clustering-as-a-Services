# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
CAAS_APP_NAME=Clustering-as-a-Service
CAAS_ENVIRONMENT=development
CAAS_DEBUG=false
CAAS_API_PREFIX=/api/v1
CAAS_LOG_LEVEL=INFO

# Allowed browser origins, separated by commas (no trailing slashes).
CAAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------
# Infrastructure: host-machine development defaults
# ---------------------------------------------------------------
# These credentials are examples ONLY for a disposable LOCAL database.
# Replace them for any shared or deployed environment.
CAAS_DATABASE_URL=postgresql+psycopg://caas:caas@localhost:5432/caas
CAAS_REDIS_URL=redis://localhost:6379/0

# When running inside Docker, localhost would mean that container.
# Later, the Compose configuration will set container-service hostnames.
CAAS_QUEUE_NAME=clustering
CAAS_JOB_TIMEOUT_SECONDS=600
CAAS_JOB_RESULT_TTL_SECONDS=86400
CAAS_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------
# Dataset handling
# ---------------------------------------------------------------
# Relative paths are resolved from the project root.
CAAS_UPLOAD_DIR=storage/uploads
CAAS_MAX_UPLOAD_SIZE_MB=25
CAAS_MAX_DATASET_ROWS=100000
CAAS_MAX_DATASET_COLUMNS=100

# ---------------------------------------------------------------
# Machine-learning defaults
# ---------------------------------------------------------------
CAAS_DEFAULT_RANDOM_SEED=42
CAAS_KMEANS_MAX_ITERATIONS=300
CAAS_KMEANS_TOLERANCE=0.0001
CAAS_MAX_CLUSTERS=20
CAAS_SILHOUETTE_SAMPLE_SIZE=1500

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
CAAS_JWT_ALGORITHM=HS256
CAAS_ACCESS_TOKEN_EXPIRE_MINUTES=60
