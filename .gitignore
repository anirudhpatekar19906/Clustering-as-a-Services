# ----------------------------------------------
# Clustering-as-a-Service — Full-stack .gitignore
# ----------------------------------------------

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode, builds, and package artifacts
__pycache__/
*.py[cod]
*.pyd
*.so
build/
dist/
*.egg-info/

# Python test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.pytype/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml

# Node.js dependencies and frontend build output
node_modules/
.next/
out/
.turbo/
.vercel/
.npm/
*.tsbuildinfo
next-env.d.ts

# Local environment variables and private credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Runtime logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Local service data (use Docker-managed volumes in deployment)
redis-data/
postgres-data/
docker-volumes/

# User-uploaded datasets and generated runtime artifacts
uploads/
data/uploads/
storage/uploads/
results/runtime/
results/tmp/

# Local development databases
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Frontend tooling caches
.eslintcache
.cache/

# Local runtime storage
storage/
